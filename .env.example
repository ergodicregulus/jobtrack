# Copy to .env for local overrides. docker-compose.yml already sets sane
# development defaults, so this file is only needed if you want to change them.
#
# Every variable is validated at startup and every problem is reported at once.
# A service that starts fine and fails an hour later on a missing value is a
# service that pages someone at 3 a.m.

# --- Core ---
APP_ENV=dev                    # dev | staging | prod
LOG_LEVEL=debug                # debug | info | warn | error
LOG_JSON=false                 # true in production
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=45s           # must be < terminationGracePeriodSeconds

# --- Database ---
# Hostnames are compose service names, not localhost: the containers share a
# network. This surprises everyone moving from a host-based setup exactly once.
DATABASE_URL=postgres://jobtrack:dev@postgres:5432/jobtrack?sslmode=disable
# Pool sizes default per service from the connection budget in
# docs/architecture/service-topology.md §5. Override only with a reason.
# DB_MAX_CONNS=10
# DB_STATEMENT_TIMEOUT=10s

# --- Object storage (S3-compatible; MinIO locally) ---
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=jobtrack-dev
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_USE_SSL=false

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SAMPLE_RATIO=1.0          # 0.1 in production

# --- Security ---
# Minimum 32 characters. Startup refuses a value beginning with "dev-" when
# APP_ENV=prod, so this placeholder cannot reach production by accident.
SESSION_SECRET=dev-only-not-a-real-secret-min-32-chars
SESSION_TTL=720h
COOKIE_SECURE=false            # forced true when APP_ENV=prod
# Comma-separated. X-Forwarded-For is honoured ONLY from these addresses;
# trusting it unconditionally makes rate limiting trivially bypassable.
# TRUSTED_PROXIES=10.0.0.1

# --- Ingestion ---
INGEST_ENABLED=true
# fixture  : replay golden files, no network at all (default)
# recorded : replay a captured session with realistic timing
# live     : real requests — REFUSES TO START without INGEST_LIVE_ALLOWLIST
INGEST_MODE=fixture
# INGEST_LIVE_ALLOWLIST=1,2,3
INGEST_TIER_A_INTERVAL=2h
INGEST_TIER_B_INTERVAL=6h
INGEST_TIER_C_INTERVAL=24h
INGEST_MAX_HOSTS=10
INGEST_USER_AGENT=JobTrackBot/1.0 (+https://jobtrack.dev/bot)

# --- Optional ---
# LOG_SQL=true                 # logs every query with timing; noisy by design
# PG_PORT=5433                 # if 5432 is taken on the host
